 concerns and constraints of normal society and follows his transformation from mild family man to a kingpin of the drug trade." resource-id="com.example.ott:id/hero_overview" class="android.widget.TextView" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[544,1186][3648,1328]" drawing-order="3" hint="" /></node></node></node><node index="1" text="" resource-id="com.example.ott:id/hero_dots" class="android.widget.LinearLayout" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1716,1480][2476,1512]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1716,1480][1804,1512]" drawing-order="1" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1820,1480][1852,1512]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1868,1480][1900,1512]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.View" package="com.exa