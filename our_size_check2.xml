o years left to live. With a new sense of fearlessness based on his medical prognosis, and a desire to secure his family's financial security, White chooses to enter a dangerous world of drugs and crime and ascends to power in this world. The series explores how a fatal diagnosis such as White's releases a typical man from the daily concerns and constraints of normal society and follows his transformation from mild family man to a kingpin of the drug trade." resource-id="com.example.ott:id/hero_overview" class="android.widget.TextView" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[544,1410][3272,1552]" drawing-order="3" hint="" /></node></node></node></node><node index="1" text="" resource-id="com.example.ott:id/hero_dots" class="android.widget.LinearLayout" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1716,1704][2476,1736]" drawing-order="2" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1716,1704][1804,1736]" drawing-order="1" hint="" /><node index="1" text="" resource-id="" class="android.view.View" package="com.example.ott" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1820,1704][1852,1736]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.View" package="com.exampl