<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep obsidian frosted glass background with cinema grade readability -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FC04070D"
                android:centerColor="#F5060A12"
                android:endColor="#0004070D"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle luminous neon rim glow on the right border -->
    <item
        android:left="-2dp"
        android:top="0dp"
        android:bottom="0dp"
        android:right="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1A00E5FF" />
        </shape>
    </item>
</layer-list>
