<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Hero Carousel Stack Viewport -->
    <FrameLayout
        android:id="@+id/hero_stack"
        android:layout_width="match_parent"
        android:layout_height="390dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Layered Card Container: Holds Active Card, Peek 1, Peek 2, and sliding buffer -->
        <FrameLayout
            android:id="@+id/hero_cards_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Active Slot Focus & Content Overlay (mirrors Active Card bounds) -->
        <FrameLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="210dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="blocksDescendants"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Crisp white rounded focus border (visible when hero carousel is focused) -->
            <View
                android:id="@+id/hero_focus_border"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_focus_border"
                android:alpha="0" />

            <!-- Top-Left Content/Trending Badge -->
            <TextView
                android:id="@+id/hero_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="20dp"
                android:background="@drawable/badge_pill_bg"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/hotstar_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:visibility="gone"
                tools:ignore="RtlSymmetry" />

            <!-- Bottom Content Block: Title, Metadata, Synopsis -->
            <LinearLayout
                android:id="@+id/hero_text_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="26dp"
                android:paddingEnd="32dp"
                android:paddingBottom="24dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="@color/white"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <!-- Metadata Row with Rating & Quality Badges -->
                <LinearLayout
                    android:id="@+id/hero_meta_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hero_content_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_rating_pill_bg"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="U/A 16+"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="visible"
                        tools:ignore="RtlSymmetry" />

                    <TextView
                        android:id="@+id/hero_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/hotstar_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/hero_quality_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_rating_pill_bg"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="4K • Dolby Vision"
                        android:textColor="@color/hotstar_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="visible"
                        tools:ignore="RtlSymmetry" />
                </LinearLayout>

                <!-- Synopsis / Description -->
                <TextView
                    android:id="@+id/hero_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/hotstar_text_muted"
                    android:textSize="13.5sp" />

                <!-- Optional Non-Focusable Visual Buttons (kept hidden for 100% JioHotstar parity) -->
                <LinearLayout
                    android:id="@+id/hero_cta_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/hero_btn_watch"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/btn_hero_primary_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="18dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_play_arrow"
                            android:tint="@color/hotstar_btn_primary_text"
                            tools:ignore="UseAppTint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Watch Now"
                            android:textColor="@color/hotstar_btn_primary_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hero_btn_watchlist"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/btn_hero_secondary_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:focusable="false"
                        android:focusableInTouchMode="false">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_plus"
                            android:tint="@color/white"
                            tools:ignore="UseAppTint" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Watchlist"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Animated Capsule & Dot Indicator Strip -->
    <LinearLayout
        android:id="@+id/hero_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:orientation="horizontal" />
</LinearLayout>
