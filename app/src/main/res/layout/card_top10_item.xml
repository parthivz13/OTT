<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/top10_card_root"
    android:layout_width="195dp"
    android:layout_height="240dp"
    android:layout_marginEnd="16dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 1. Giant Netflix-style 3D Outlined Rank Number -->
    <com.example.ott.ui.rows.top10.RankNumberView
        android:id="@+id/top10_rank_number"
        android:layout_width="90dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="4dp" />

    <!-- 2. Overlapping Portrait Poster Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top10_card_surface"
        android:layout_width="135dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="@color/hotstar_card_surface"
        app:cardCornerRadius="10dp"
        app:cardElevation="3dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Poster Artwork -->
            <ImageView
                android:id="@+id/top10_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <!-- Bottom Gradient Scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_gravity="bottom"
                android:background="@drawable/card_bottom_scrim" />

            <!-- Top-Left Red "TOP 10" Badge -->
            <TextView
                android:id="@+id/top10_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/badge_top10_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="TOP 10"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:ignore="SmallSp" />

            <!-- Card Bottom Title -->
            <TextView
                android:id="@+id/top10_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Rounded Focus Border (appears on focus) -->
    <View
        android:id="@+id/top10_focus_ring"
        android:layout_width="135dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:background="@drawable/top10_card_focus_ring"
        android:elevation="14dp"
        android:alpha="0" />

</FrameLayout>
