<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Global Dynamic Backdrop for Center-stay Rails -->
    <ImageView
        android:id="@+id/iv_global_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0" />

    <!-- Gradient Scrim overlay for readability -->
    <View
        android:id="@+id/view_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hotstar_backdrop_scrim"
        android:alpha="0" />

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/main_browse_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Luxury Floating Glassmorphic Side Navigation with Curved Arch -->
    <FrameLayout
        android:id="@+id/nav_container"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Signature JioHotstar Curved Arch Backdrop -->
        <com.example.ott.ui.navigation.NavArchView
            android:id="@+id/nav_arch_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Celestial Spark Emblem -->
            <ImageView
                android:id="@+id/iv_nav_brand_spark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Brand Emblem"
                android:src="@drawable/ic_brand_spark" />

            <!-- 1. Connect Phone -->
            <LinearLayout
                android:id="@+id/nav_connect_phone"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_connect_phone_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_connect_phone_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_connect_phone"
                    android:src="@drawable/ic_nav_connect_phone" />

                <TextView
                    android:id="@+id/nav_connect_phone_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_connect_phone" />
            </LinearLayout>

            <!-- 2. Search -->
            <LinearLayout
                android:id="@+id/nav_search"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_search_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_search_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_search"
                    android:src="@drawable/ic_nav_search" />

                <TextView
                    android:id="@+id/nav_search_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_search" />
            </LinearLayout>

            <!-- 3. Home -->
            <LinearLayout
                android:id="@+id/nav_home"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_home_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_home_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_home"
                    android:src="@drawable/ic_nav_home" />

                <TextView
                    android:id="@+id/nav_home_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_home" />
            </LinearLayout>

            <!-- 4. TV -->
            <LinearLayout
                android:id="@+id/nav_tv"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_tv_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_tv_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_tv"
                    android:src="@drawable/ic_nav_tv" />

                <TextView
                    android:id="@+id/nav_tv_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_tv" />
            </LinearLayout>

            <!-- 5. Movies -->
            <LinearLayout
                android:id="@+id/nav_movies"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_movies_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_movies_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_movies"
                    android:src="@drawable/ic_nav_movies" />

                <TextView
                    android:id="@+id/nav_movies_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_movies" />
            </LinearLayout>

            <!-- 6. Sports -->
            <LinearLayout
                android:id="@+id/nav_sports"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_sports_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_sports_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_sports"
                    android:src="@drawable/ic_nav_sports" />

                <TextView
                    android:id="@+id/nav_sports_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_sports" />
            </LinearLayout>

            <!-- 7. Categories -->
            <LinearLayout
                android:id="@+id/nav_categories"
                style="@style/SideNavPillItem">

                <View
                    android:id="@+id/nav_categories_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_categories_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_categories"
                    android:src="@drawable/ic_nav_categories" />

                <TextView
                    android:id="@+id/nav_categories_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_categories" />
            </LinearLayout>

            <!-- Flexible Space pushes My Space to bottom -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 8. My Space (Bottom User Profile) -->
            <LinearLayout
                android:id="@+id/nav_my_space"
                style="@style/SideNavPillItem"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/nav_my_space_indicator"
                    style="@style/NavActiveIndicator" />

                <ImageView
                    android:id="@+id/nav_my_space_icon"
                    style="@style/SideNavIcon"
                    android:contentDescription="@string/nav_my_space"
                    android:src="@drawable/ic_nav_myspace_avatar" />

                <TextView
                    android:id="@+id/nav_my_space_label"
                    style="@style/SideNavLabel"
                    android:text="@string/nav_my_space" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
