<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Global Dynamic Backdrop for Center-stay Rails -->
    <ImageView
        android:id="@+id/iv_global_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0" />

    <!-- Gradient Scrim overlay for readability -->
    <View
        android:id="@+id/view_backdrop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hotstar_backdrop_scrim"
        android:alpha="0" />

    <!-- Main Content Area -->
    <FrameLayout
        android:id="@+id/main_browse_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="68dp"
        android:layout_marginEnd="16dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- Luxury Floating Glassmorphic Side Navigation -->
    <com.example.ott.ui.navigation.SideNavView
        android:id="@+id/side_nav_view"
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />
</FrameLayout>

