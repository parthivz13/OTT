<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SideNavPillItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/nav_pill_row_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="NavActiveIndicator">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:background">@drawable/nav_active_indicator</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="SideNavContentRow">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="SideNavIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:tint">@color/nav_icon_tint</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="SideNavItem">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/nav_item_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="SideNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:alpha">0</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nav_label_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
        <item name="android:duplicateParentState">true</item>
    </style>
</resources>
